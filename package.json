{
  "name": "logos",
  "private": true,
  "workspaces": [
    "apps/dashboard",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @logos/api\" \"npm run dev -w @logos/dashboard\"",
    "build": "npm run build --workspaces",
    "test": "npm test -w @logos/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
